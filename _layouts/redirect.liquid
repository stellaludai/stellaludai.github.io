{% assign redirect_url = page.redirect_to | relative_url %}
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Redirecting to the article</title>
    <link rel="canonical" href="{{ page.redirect_to | absolute_url }}">
    <script>
      window.location.replace({{ redirect_url | jsonify }} + window.location.search + window.location.hash);
    </script>
    <noscript>
      <meta http-equiv="refresh" content="0; url={{ redirect_url }}">
    </noscript>
    <style>
      body {
        margin: 3rem auto;
        padding: 0 1.5rem;
        max-width: 52rem;
        background: #f7f0e4;
        color: #393228;
        font:
          1rem/1.6 system-ui,
          sans-serif;
      }
      a {
        color: #395a46;
      }
    </style>
  </head>
  <body>
    <p>Redirecting to <a href="{{ redirect_url }}">Doing AI4Science in a Data Desert</a>…</p>
  </body>
</html>
